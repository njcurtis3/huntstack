# Control-plane tokens for the `services` agent. COPY (do not move) this to
# `.env.services` in the same folder, then fill in. `.env.services` is
# gitignored; this template is not.
#
# FORMAT IS STRICT: `NAME=value` with NO space around the `=` and no quotes.
# A space makes bash run the value as a command and echo your secret. See
# credentials.md.
#
# Leave any line blank to skip that service — the agent reports it as skipped
# rather than failing the run.

# Cloudflare — "Account API Tokens" tab, scope: Account / Cloudflare Pages / Read.
# Account ID is the 32-hex string in the dashboard URL (not a secret).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Railway — account token (not a project token)
RAILWAY_API_TOKEN=

# Sentry — personal token: project:read, org:read, event:read
SENTRY_AUTH_TOKEN=
SENTRY_ORG=

# Supabase — Management API personal access token
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# Together.ai — same key as the repo .env; only used for a model-availability probe
TOGETHER_API_KEY=

# GitHub — fine-grained token for njcurtis3/huntstack, Actions: Read
GITHUB_TOKEN=
