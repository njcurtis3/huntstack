# Base URL of the HuntStack API this build talks to, without a trailing slash.
# EXPO_PUBLIC_* variables are inlined into the bundle by the Expo bundler, so this
# is a build-time value, not a runtime one.
#
# Leave it unset in development: the app derives http://<metro-dev-server-host>:4000
# from expo-constants' hostUri, which is the LAN address your phone or emulator
# already reached Metro on. localhost is not routable from either, and apps/api
# already binds HOST 0.0.0.0.
#
# Set it when the API is somewhere else, or for any production build — a
# production build with it unset throws a configuration error rather than
# guessing. The production domain is not in this repo; it lives in the
# Cloudflare/Railway environment.
#
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
EXPO_PUBLIC_API_URL=
